# ==========================
# Root Query
# ==========================
type Query {
    # ---- Reportes y filtros ----
    donationReport(
        categoryId: Int,
        startDate: String,
        endDate: String,
        deleted: Boolean
    ): [DonationReportGroup!]!

    savedFilters: [SavedFilter!]!
    savedFilter(id: ID!): SavedFilter
    categories: [Category!]!
    category(id: Int!): Category
    getUserId(usernameOrEmail: String!): ID!

    # ---- Participación ----
    participationEvents(
        username: String!,
        startDate: String,
        endDate: String,
        distribution: DonationDistributionFilter
    ): [ParticipationEvent]
}

# ==========================
# Root Mutation
# ==========================
type Mutation {
    saveFilter(input: FilterInput!): SavedFilter!
    updateFilter(id: ID!, input: FilterInput!): SavedFilter!
    deleteFilter(id: ID!): Boolean!
}

# ==========================
# Tipos relacionados a donaciones
# ==========================
type DonationReportGroup {
    categoryId: Int!
    categoryName: String!
    deleted: Boolean!
    totalQuantity: Int!
    donations: [Donation!]!
}

type Donation {
    id: ID
    categoryId: Int
    categoryName: String
    description: String!
    quantity: String! # Si en uno era Int y en otro String, podés normalizarlo a uno
    createdAt: String
    updatedAt: String
    deleted: Boolean
}

type SavedFilter {
    id: ID!
    name: String!
    categoryId: Int
    categoryName: String
    userId: Int!
    username: String!
    startDate: String
    endDate: String
    filterDeleted: Boolean
    isDeleted: Boolean!
}

type Category {
    id: Int!
    name: String!
    description: String
}

input FilterInput {
    name: String!
    categoryId: Int
    startDate: String
    endDate: String
    deleted: Boolean
    filterDeleted: Boolean
    username: String!
}

type ParticipationEvent {
    name: String!
    datetime: String!
    description: String!
    donations: [Donation]
}

enum DonationDistributionFilter {
    YES
    NO
    BOTH
}

type Query {
    participationEvents(
        username: String!,
        startDate: String,
        endDate: String,
        distribution: DonationDistributionFilter
    ): [ParticipationEvent]
}

type ParticipationEvent {
    name: String!
    date: String!
    description: String!
    donations: [Donation]
}

type Donation {
    category: String!
    description: String!
    quantity: String!
}

enum DonationDistributionFilter {
    YES
    NO
    BOTH
}